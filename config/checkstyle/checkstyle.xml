<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- client-only 클래스 import 금지 (main 소스셋) -->
        <module name="IllegalImport">
            <property name="illegalPkgs"
                value="net.minecraft.client, com.jjk.client"/>
            <message key="import.illegal"
                value="main 소스셋에 client-only import 금지: {0}"/>
        </module>

        <!-- 빈 catch 블록 금지 (주석만 있는 경우 허용) -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|expected"/>
            <property name="commentFormat" value="^.*$"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- 매직 넘버 경고 (§LOCK 수치 하드코딩 방지) -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="severity" value="warning"/>
        </module>
    </module>

    <!-- 파일 끝 개행 -->
    <module name="NewlineAtEndOfFile">
        <property name="severity" value="warning"/>
    </module>
</module>
